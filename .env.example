# ---------------------------------------------------------------------------
# pkviewer configuration
#
# Every origin below is deployment configuration, never an architectural fact.
# No absolute pkviewer URL is ever persisted to the database; URLs are composed
# at render time from these values. See docs/decisions.md §17.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- origins -------------------------------------------------------------
#
# Two origins, split by a single rule:
#   anything rendering user-authored presentation -> PUBLIC_USERCONTENT_ORIGIN
#   anything reading or writing a session         -> PUBLIC_APP_ORIGIN
#
# Public system and member pages (/s/...) are served from the USERCONTENT origin
# from day one. They are user-authored presentation the moment custom CSS lands
# in v1.1, and moving them then would break every public URL ever shared. That
# makes the usercontent origin the public, shareable, flagship one -- it gets
# the memorable hostname -- while the app origin is the one nobody types.
#
# Beta:  public pages  https://system.doughmination.gay
#        app / manage  https://app.doughmination.gay
# Production: filled in when the dedicated pkviewer domain exists.

# Session-bearing: /, /login, /docs, /manage, /auth. Never renders user content.
PUBLIC_APP_ORIGIN=http://app.localhost:3000

# Public pages (/s/...). Never receives the session cookie: __Host- forbids a
# Domain attribute, so the cookie cannot reach a sibling host. Must never equal
# PUBLIC_APP_ORIGIN, in any environment, including development.
PUBLIC_USERCONTENT_ORIGIN=http://system.localhost:3000

# May equal the usercontent origin during beta.
PUBLIC_ASSET_ORIGIN=http://system.localhost:3000

# Documentation lives on a separate site, not inside this application. Leave
# empty to hide the documentation links entirely.
# Beta: https://docs.doughmination.gay
PUBLIC_DOCS_URL=

# --- api -----------------------------------------------------------------
API_PORT=3001
# Where the Next.js tier reaches the API. Internal; never public.
INTERNAL_API_ORIGIN=http://127.0.0.1:3001

# --- database ------------------------------------------------------------
DATABASE_PATH=./data/pkviewer.db

# --- pluralkit -----------------------------------------------------------
PK_API_BASE=https://api.pluralkit.me/v2
# Contact URL embedded in the User-Agent. Point this at the REPOSITORY, not the
# deployment origin, so it survives the beta -> production domain move. The UA
# must be identical across every instance and must never vary by user or server.
PK_USER_AGENT_CONTACT=https://github.com/doughmination/pkviewer
# Self-imposed ceilings, deliberately below PluralKit's documented 10/s reads
# and 3/s writes, leaving headroom for burst and clock imprecision.
PK_RATE_LIMIT_READ_RPS=6
PK_RATE_LIMIT_WRITE_RPS=2

# --- discord oauth -------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comma-separated, so beta and production URIs can both be registered ahead of
# the domain move and the cutover needs no flag day.
DISCORD_REDIRECT_URIS=http://app.localhost:3000/auth/discord/callback

# --- beta ----------------------------------------------------------------
# While true: X-Robots-Tag noindex on every response, claiming restricted to
# BETA_ALLOWED_DISCORD_IDS, and a third-party/beta indicator on public pages.
BETA_MODE=true
SIGNUP_ENABLED=true
BETA_ALLOWED_DISCORD_IDS=

# --- secrets -------------------------------------------------------------
# 32+ random bytes, base64. Rotate by generating a new one; sessions are
# server-side, so rotation invalidates them rather than corrupting them.
SESSION_SECRET=
