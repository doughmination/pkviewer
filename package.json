{
  "name": "pkviewer",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "migrate": "bun run --cwd apps/api migrate",
    "test": "bun test",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd packages/shared typecheck && bun run --cwd apps/web typecheck",
    "check:domain": "bash scripts/check-no-hardcoded-origin.sh",
    "check": "bun run check:domain && bun run typecheck && bun test",
    "dev": "bun run scripts/dev.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "admin:list": "bun run apps/api/scripts/admin.ts list",
    "admin:grant": "bun run apps/api/scripts/admin.ts grant",
    "admin:revoke": "bun run apps/api/scripts/admin.ts revoke"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
